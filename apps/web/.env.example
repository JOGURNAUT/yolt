DATABASE_URL=postgres://yolt:yolt@localhost:5433/yolt
# Signs sandbox "gateway" webhooks in development.
SANDBOX_WEBHOOK_SECRET=dev-sandbox-secret
# Vercel Cron sends this as a Bearer token to /api/cron/expire-holds.
CRON_SECRET=dev-cron-secret
# Media storage: Cloudflare R2 in production; RustFS from docker-compose locally (run `pnpm media:setup` once).
MEDIA_ENDPOINT=http://localhost:9000
MEDIA_BUCKET=yolt-media
MEDIA_ACCESS_KEY_ID=yolt
MEDIA_SECRET_ACCESS_KEY=yolt-dev-secret
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/yolt-media
# Secret mixed into OTP and IP hashes. Required in production: openssl rand -hex 32
AUTH_PEPPER=dev-auth-pepper
# development | staging | production (see src/lib/env.ts). Unset on a production build means production.
APP_ENV=development
# Staging only: shared password for the whole site (HTTP Basic auth, any username).
STAGING_ACCESS_PASSWORD=
# Shown on the legal pages; required in production.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_CIN=
SUPPORT_EMAIL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE=

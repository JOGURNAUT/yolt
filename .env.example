# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://yolt:yolt@localhost:5433/yolt
# Separate database used by tests (created by docker/init.sql)
TEST_DATABASE_URL=postgres://yolt:yolt@localhost:5433/yolt_test
# Web push: leave empty to use the dev fake. Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
